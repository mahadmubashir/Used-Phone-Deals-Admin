# ---------------------------------------------------------------------------
# UsedPhoneDeals.com — Supplier / Admin Portal
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Backend API. Must be the SAME API as the buyer portal — one database, two
# front ends. The session cookie is httpOnly, so this origin has to be on the
# API's CORS allow-list with credentials: true.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Serve fixtures instead of calling the API. Set to false once the backend is up.
VITE_USE_MOCKS=true

# Which mock role to sign in as while USE_MOCKS is true:
#   supplier | csr | admin
# Ignored entirely when USE_MOCKS is false.
VITE_MOCK_ROLE=admin

# Buyer portal URL — used only for "view on site" links in catalogue management.
VITE_BUYER_PORTAL_URL=http://localhost:3000

# Stripe Connect — publishable key only, for the supplier onboarding redirect.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
